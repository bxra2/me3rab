---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Kashida from '../../components/Kashida.astro';
import { toArabicDigits } from '../../utils/arabicDigits';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const fmt = new Intl.DateTimeFormat('ar-EG', { dateStyle: 'long' });
const hasSidenotes = (post.body ?? '').includes('^[');
---

<BaseLayout title={post.data.title}>
  <div class:list={['with-aside', { 'has-sidenotes': hasSidenotes }]}>
    <article>
      <header>
        <div class="title-row">
          <time>{fmt.format(post.data.date)}</time>
          <h1>{post.data.title}</h1>
        </div>
      </header>
      <div class="post-body">
        <Content />
      </div>
    </article>
    <aside class="aside-box toc">
      <p class="tag-list aside-tags">
        {post.data.tags.map((t) => (
          <a class="tag" href={`${import.meta.env.BASE_URL}/م/${t}`}>{t}</a>
        ))}
      </p>
      {post.data.toc && (
        <div>
          <h2 class="aside-title">محتويات</h2>
          <ul>
            {tocItems.map((h) => (
              <li class={h.depth === 3 ? 'toc-h3' : ''}>
                <a href={`#${h.slug}`}>{toArabicDigits(h.text)}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
  <Kashida selector=".post-body p" />
</BaseLayout>
