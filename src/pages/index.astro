---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const articles = await getCollection('script');
const forgotten = articles.find((a) => a.id === 'المهمل-والمتروك');
const forgottenHref = forgotten ? `/الخط/${forgotten.id}` : '/الخط';
---

<BaseLayout title="الرئيسية">
  <div class="with-aside">
    <section>
      <header>
        <h1>معراب</h1>
        <section class="intro">
          <p class="intro-lede">
            معراب مشروعٌ لتعريب المصطلح التقني: يضع لكل مصطلح مقابلًا عربيًا
            واحدًا، بشرحٍ موجز ومصدرٍ موثّق، على ورق مطبعة.
          </p>
          <p>
            تتفرّق المصطلحات الوافدة بين ترجماتٍ متباينة، فيضيع القارئ بين لفظٍ
            وآخر. يثبّت معراب مقابلًا واحدًا، ويربط كل مصطلح بعلاقاته من تمييزٍ
            وعائلةٍ وسلسلة.
          </p>
          <ol class="intro-steps">
            <li>نرصد المصطلح في مصادره، ونقارن ما قيل فيه.</li>
            <li>نختار مقابلًا واحدًا، ونشرح لماذا.</li>
            <li>نحرّره وننشره، ونعيد النظر فيه كلما جدّ جديد.</li>
          </ol>
        </section>
        <p>
          <a href="/مدونة">المدونة</a> · <a href="/مصطلحات">مصطلحات</a>
        </p>
      </header>
      <div class="hub-grid">
        <a class="card hub-card" href="/معاجم" aria-label="معاجم: تصفح المعاجم التخصصية">
          <span class="hub-card-kicker">قسم جديد</span>
          <h2 class="hub-card-title">معاجم</h2>
          <p class="hub-card-desc">
            معاجم تخصصية تفاعلية لكل علم: نبدأ بالكيمياء، ونقارن المصطلح بين
            العربية والإنجليزية والفرنسية بحسب المصدر أو المعجم.
          </p>
          <span class="hub-card-cta">تصفح المعاجم</span>
        </a>
        <a class="card hub-card" href="/الخط" aria-label="الخط العربي: تاريخ الحرف وامتداده إلى اللغات الأخرى">
          <span class="hub-card-kicker">قسم جديد</span>
          <h2 class="hub-card-title">الخط العربي</h2>
          <p class="hub-card-desc">
            تاريخ الحرف العربي من النبطية إلى الأقلام الستة، وتكيّفه مع
            الفارسية والأردية والسندية والبشتوية وغيرها.
          </p>
          <span class="hub-card-cta">تصفح الخط</span>
        </a>
        <a class="card hub-card" href={forgottenHref} aria-label="المهمل والمتروك: خط التاج والعلامات المندثرة">
          <span class="hub-card-kicker">مهمل ومتروك</span>
          <h2 class="hub-card-title">المهمل والمتروك</h2>
          <p class="hub-card-desc">
            خط التاج، وعلامات الوقف القديمة، والألف الخنجرية، والحروف التي
            اندثرت؛ ما كان من الكتابة ثم تُرك.
          </p>
          <span class="hub-card-cta">اقرأ المقال</span>
        </a>
      </div>
    </section>
    <aside class="aside-box">
      <h2 class="aside-title">روابط</h2>
      <ul class="link-list">
        <li>
          <a href={site.github} target="_blank" rel="noopener">
            <svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="8 6 3 12 8 18" />
              <line x1="21" y1="6" x2="13" y2="18" />
            </svg>
            GitHub
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`}>
            <svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" />
              <polyline points="2,4 12,13 22,4" />
            </svg>
            البريد
          </a>
        </li>
        <li>
          <a href={site.feed}>
            <svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6" cy="18" r="2" fill="currentColor" stroke="none" />
              <path d="M4 11a9 9 0 0 1 9 9" />
              <path d="M4 4a16 16 0 0 1 16 16" />
            </svg>
            RSS
          </a>
        </li>
      </ul>
    </aside>
  </div>
</BaseLayout>
