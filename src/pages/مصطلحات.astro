---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import relations from '../data/relations.json'
import { toArabicDigits } from '../utils/arabicDigits'
import {
    TermStatus,
    statusBadgeClass,
} from '../data/termStatuses'
import type {
    TermStatusKey,
    TermSourceKey,
    TermMotivationKey,
    TermFormationKey,
} from '../data/termStatuses'
import type { TermView } from '../utils/interfaces'

const rawEntries = await getCollection('terms')
const currentTermStatus = 'all'

const entries: TermView[] = rawEntries
    .map((entry) => ({
        term: entry.data.term,
        translation: entry.data.translation,
        explanation: entry.data.explanation,
        source: entry.data.source,
        status: entry.data.status as TermStatusKey,
        termSource: entry.data.termSource as TermSourceKey,
        termMotivation: entry.data.termMotivation as TermMotivationKey,
        termFormation: entry.data.termFormation as TermFormationKey,
        alternatives: entry.data.alternatives,
        languages: entry.data.languages,
        derivations: entry.data.derivations,
        isComplete: entry.data.isComplete ?? false,
    }))
    .sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }))

const slugFor = new Map(rawEntries.map((entry) => [entry.data.term, entry.id]))
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/'

const relationsFor = (term: string) =>
    relations.filter((r) => r.terms.includes(term))

const searchEntries = entries.map((e) => ({
    term: e.term,
    translation: e.translation,
    explanation: e.explanation,
    status: e.status,
    source: (e.source ?? []).map((s) => ({ name: s.name })),
    languages: (e.languages ?? []).map((l) => l.term),
}))

const statusCounts = Object.fromEntries(
    (Object.keys(TermStatus) as TermStatusKey[]).map((status) => [
        status,
        entries.filter((e) => e.status === status).length,
    ])
) as Record<TermStatusKey, number>

const stats = {
    total: entries.length,
    translated: entries.filter((e) => Boolean(e.translation?.trim())).length,
    finished: statusCounts.agreed,
}

const statRows = [
    { label: 'المجموع', value: stats.total, filter: 'all' },
    { label: 'مترجَم', value: stats.translated, filter: 'translated' },
    { label: 'مُنجَز', value: stats.finished, filter: 'done' },
    {
        label: TermStatus.proposed,
        value: statusCounts.proposed,
        filter: 'proposed',
    },
    { label: TermStatus.coined, value: statusCounts.coined, filter: 'coined' },
    { label: TermStatus.agreed, value: statusCounts.agreed, filter: 'agreed' },
    {
        label: TermStatus.abandoned,
        value: statusCounts.abandoned,
        filter: 'abandoned',
    },
]

const latinLetters = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ']
const letterOf = (term: string) => term.trim()[0].toUpperCase()
const entriesFor = (letter: string) =>
    entries.filter((e) => letterOf(e.term) === letter)
---

<BaseLayout title='مصطلحات'>
    <header>
        <h1>مصطلحات</h1>
        <div class='term-intro'>
            <p>
                معجمٌ واحدٌ لواحد: انقر أي مدخل لزيارة صفحته — مقابلٌ وبدائل
                واشتقاق ومصدر.
            </p>

            <table class='term-stats'>
                <thead>
                    <tr>
                        {
                            statRows.map(({ label }) => (
                                <th scope='col'>{label}</th>
                            ))
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        {
                            statRows.map(({ value }) => (
                                <td>{toArabicDigits(String(value))}</td>
                            ))
                        }
                    </tr>
                    <tr>
                        {
                            statRows.map(({ filter, label }, i) => (
                                <td>
                                    <input
                                        type='radio'
                                        name='term-filter'
                                        value={filter}
                                        id={`term-filter-${i}`}
                                        aria-label={label}
                                        checked={
                                            filter === currentTermStatus &&
                                            i === 0
                                        }
                                    />
                                </td>
                            ))
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </header>

    <input
        id='term-search'
        dir='auto'
        type='search'
        placeholder='ابحث في المصطلحات…'
        aria-label='البحث في المصطلحات'
    />

    <h2>a — z</h2>
    <div dir='ltr' class='glossary-grid'>
        {
            latinLetters.map((letter) => {
                const letterEntries = entriesFor(letter)
                return (
                    <section class='letter-box' data-letter={letter}>
                        <h3>{letter}</h3>
                        {letterEntries.length ? (
                            <ul class='term-rows'>
                                {letterEntries.map((e) => (
                                    <li>
                                        <a
                                            class='term-row'
                                            data-term={e.term}
                                            href={`${base}مصطلحات/${encodeURIComponent(
                                                slugFor.get(e.term) ?? ''
                                            )}`}
                                        >
                                            <span class='term-row-term'>
                                                {toArabicDigits(e.term)}
                                                {e.isComplete && (
                                                    <span
                                                        class='term-complete'
                                                        title='Completed'
                                                    >
                                                        ✓
                                                    </span>
                                                )}
                                            </span>
                                            <span class='term-row-translation'>
                                                {e.translation
                                                    ? toArabicDigits(
                                                          e.translation
                                                      )
                                                    : '—'}
                                            </span>
                                            <span
                                                class:list={[
                                                    'badge',
                                                    statusBadgeClass[e.status],
                                                ]}
                                            >
                                                {TermStatus[e.status]}
                                            </span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        ) : (
                            <p class='letter-empty'>لا مصطلحات بعد</p>
                        )}
                    </section>
                )
            })
        }
    </div>

    <p class='no-results' hidden>لا نتائج تطابق بحثك.</p>

    <script
        is:inline
        type='application/json'
        id='term-data'
        set:html={JSON.stringify(searchEntries).replace(/</g, '\\u003c')}
    />
    <script
        is:inline
        type='application/json'
        id='relation-data'
        set:html={JSON.stringify(relations).replace(/</g, '\\u003c')}
    />

    <script>
        const search = document.getElementById(
            'term-search'
        ) as HTMLInputElement
        const noResults = document.querySelector('.no-results') as HTMLElement
        const boxes = [...document.querySelectorAll('.letter-box')]
        const entries = JSON.parse(
            document.getElementById('term-data')?.textContent ?? '[]'
        ) as {
            term: string
            translation: string
            explanation: string
            status?: string
            source?: { name: string }[]
            languages?: string[]
        }[]
        const relations = JSON.parse(
            document.getElementById('relation-data')?.textContent ?? '[]'
        ) as { type: string; terms: string[]; note: string }[]

        const relationsFor = (term: string) =>
            relations.filter((r) => r.terms.includes(term))

        const entryOf = (term: string | undefined) =>
            entries.find((e) => e.term === term)
        const matches = (e: (typeof entries)[number], q: string) =>
            [
                e.term,
                e.translation,
                e.explanation,
                ...(Array.isArray(e.source) ? e.source : []).map((s) => s.name),
                ...(e.languages ?? []),
                ...relationsFor(e.term).flatMap((r) => [r.note, ...r.terms]),
            ]
                .join(' ')
                .toUpperCase()
                .includes(q)

        const currentFilter = () =>
            document.querySelector<HTMLInputElement>(
                'input[name="term-filter"]:checked'
            )?.value ?? 'all'

        const passesFilter = (e: (typeof entries)[number], f: string) => {
            if (f === 'all') return true
            if (f === 'translated') return Boolean(e.translation?.trim())
            return e.status === f
        }

        const applyFilters = () => {
            const q = search.value.trim().toUpperCase()
            const f = currentFilter()
            const filtering = q !== '' || f !== 'all'
            let any = false

            for (const box of boxes) {
                const rows = [...box.querySelectorAll('.term-row')]
                if (rows.length === 0) {
                    // empty-letter boxes only show when nothing is being filtered
                    box.toggleAttribute('hidden', filtering)
                    continue
                }
                let visible = 0
                for (const row of rows) {
                    const e = entryOf((row as HTMLElement).dataset.term)
                    const show =
                        e != null &&
                        passesFilter(e, f) &&
                        (q === '' || matches(e, q))
                    // hide the <li> wrapper so no empty bullets/gaps remain
                    ;(row.closest('li') ?? row).toggleAttribute('hidden', !show)
                    if (show) visible++
                }
                box.toggleAttribute('hidden', visible === 0)
                if (visible > 0) any = true
            }
            noResults.toggleAttribute('hidden', !filtering || any)
        }

        search.addEventListener('input', applyFilters)
        document
            .querySelectorAll('input[name="term-filter"]')
            .forEach((r) => r.addEventListener('change', applyFilters))
    </script>
</BaseLayout>
