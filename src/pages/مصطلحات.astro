---
import BaseLayout from '../layouts/BaseLayout.astro'
import TermDialog from '../components/TermDialog.astro'
import { getCollection } from 'astro:content'
import relations from '../data/relations.json'
import { toArabicDigits } from '../utils/arabicDigits'
import {
    TermStatus,
    statusBadgeClass,
    TermSource,
    sourceBadgeClass,
    TermMotivation,
    motivationBadgeClass,
    TermFormation,
    formationBadgeClass,
} from '../data/termStatuses'
import type {
    TermSourceKey,
    TermStatusKey,
    TermMotivationKey,
    TermFormationKey,
} from '../data/termStatuses'
import { TermView } from '../utils/interfaces'

const rawEntries = await getCollection('terms')
const currentTermStatus = 'all'

const entries: TermView[] = rawEntries
    .map((entry) => ({
        term: entry.data.term,
        translation: entry.data.translation,
        explanation: entry.data.explanation,
        source: entry.data.source,
        status: entry.data.status as TermStatusKey,
        termSource: entry.data.termSource as TermSourceKey,
        termMotivation: entry.data.termMotivation as TermMotivationKey,
        termFormation: entry.data.termFormation as TermFormationKey,
        alternatives: entry.data.alternatives,
        derivations: entry.data.derivations,
        isComplete: entry.data.isComplete ?? false,
    }))
    .sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }))

const escapeHtml = (s: string) =>
    s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;')

const relationTypeLabels: Record<string, string> = {
    family: 'عائلة',
    contrast: 'تمييز',
    pipeline: 'سلسلة',
}

const relationsFor = (term: string) =>
    relations.filter((r) => r.terms.includes(term))

const knownTerms = new Set(entries.map((e) => e.term))

const dialogProps = (e: TermView) => {
    const alts = (e.alternatives ?? [])
        .map(
            (a) =>
                `<li><strong>${escapeHtml(a.translation)}</strong> — ${escapeHtml(a.note)}</li>`
        )
        .join('')

    const derivs = (e.derivations ?? [])
        .map(
            (d) =>
                `<tr><td>${escapeHtml(d.form)}</td><td>${escapeHtml(d.gloss)}</td></tr>`
        )
        .join('')

    const rels = relationsFor(e.term)
        .map((r) => {
            const label = relationTypeLabels[r.type] ?? r.type
            const chips = r.terms
                .filter((t) => t !== e.term)
                .map((t) =>
                    knownTerms.has(t)
                        ? `<button class="relation-chip" type="button" aria-haspopup="dialog" data-term="${escapeHtml(t)}">${escapeHtml(t)}</button>`
                        : `<span class="relation-chip relation-chip--ghost">${escapeHtml(t)}</span>`
                )
                .join('')
            return `<p class="relation-group">
        <span class="badge relation-type">${escapeHtml(label)}</span>: 
        <span class="relation-chips">${chips}</span>
        <span class="relation-note">${escapeHtml(r.note)}</span>
      </p>`
        })
        .join('')

    const sources = (Array.isArray(e.source) ? e.source : [])
        .map(
            (s) =>
                `<a href="${escapeHtml(s.link)}" target="_blank" rel="noopener noreferrer">${escapeHtml(s.name)}</a>`
        )
        .join('، &nbsp;')

    return {
        e,
        status: e.status,
        termSource: e.termSource,
        termMotivation: e.termMotivation,
        termFormation: e.termFormation,
        alts,
        derivs,
        rels,
        sources,
        classes: statusBadgeClass,
        labels: TermStatus,
        sourceClasses: sourceBadgeClass,
        sourceLabels: TermSource,
        motivationClasses: motivationBadgeClass,
        motivationLabels: TermMotivation,
        formationClasses: formationBadgeClass,
        formationLabels: TermFormation,
    }
}

const searchEntries = entries.map((e) => ({
    term: e.term,
    translation: e.translation,
    explanation: e.explanation,
    status: e.status,
    source: (e.source ?? []).map((s) => ({ name: s.name })),
}))

const statusCounts = Object.fromEntries(
    (Object.keys(TermStatus) as TermStatusKey[]).map((status) => [
        status,
        entries.filter((e) => e.status === status).length,
    ])
) as Record<TermStatusKey, number>

const stats = {
    total: entries.length,
    translated: entries.filter((e) => Boolean(e.translation?.trim())).length,
    finished: statusCounts.agreed,
}

const statRows = [
    { label: 'المجموع', value: stats.total, filter: 'all' },
    { label: 'مترجَم', value: stats.translated, filter: 'translated' },
    { label: 'مُنجَز', value: stats.finished, filter: 'done' },
    {
        label: TermStatus.proposed,
        value: statusCounts.proposed,
        filter: 'proposed',
    },
    { label: TermStatus.coined, value: statusCounts.coined, filter: 'coined' },
    { label: TermStatus.agreed, value: statusCounts.agreed, filter: 'agreed' },
    {
        label: TermStatus.abandoned,
        value: statusCounts.abandoned,
        filter: 'abandoned',
    },
]

const latinLetters = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ']
const letterOf = (term: string) => term.trim()[0].toUpperCase()
const entriesFor = (letter: string) =>
    entries.filter((e) => letterOf(e.term) === letter)
---

<BaseLayout title='مصطلحات'>
    <header>
        <h1>مصطلحات</h1>
        <div class='term-intro'>
            <p>
                معجمٌ واحدٌ لواحد: انقر أي مدخل لفتح بطاقته — مقابلٌ وبدائل
                واشتقاق ومصدر.
            </p>

            <table class='term-stats'>
                <thead>
                    <tr>
                        {
                            statRows.map(({ label }) => (
                                <th scope='col'>{label}</th>
                            ))
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        {
                            statRows.map(({ value }) => (
                                <td>{toArabicDigits(String(value))}</td>
                            ))
                        }
                    </tr>
                    <tr>
                        {
                            statRows.map(({ filter, label }, i) => (
                                <td>
                                    <input
                                        type='radio'
                                        name='term-filter'
                                        value={filter}
                                        id={`term-filter-${i}`}
                                        aria-label={label}
                                        checked={
                                            filter === currentTermStatus &&
                                            i === 0
                                        }
                                    />
                                </td>
                            ))
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </header>

    <input
        id='term-search'
        dir='auto'
        type='search'
        placeholder='ابحث في المصطلحات…'
        aria-label='البحث في المصطلحات'
    />

    <h2>a — z</h2>
    <div dir='ltr' class='glossary-grid'>
        {
            latinLetters.map((letter) => {
                const letterEntries = entriesFor(letter)
                return (
                    <section class='letter-box' data-letter={letter}>
                        <h3>{letter}</h3>
                        {letterEntries.length ? (
                            <ul class='term-rows'>
                                {letterEntries.map((e) => (
                                    <li>
                                        <button
                                            class='term-row'
                                            data-term={e.term}
                                            aria-haspopup='dialog'
                                        >
                                            <span class='term-row-term'>
                                                {toArabicDigits(e.term)}
                                                {e.isComplete && (
                                                    <span
                                                        class='term-complete'
                                                        title='Completed'
                                                    >
                                                        ✓
                                                    </span>
                                                )}
                                            </span>
                                            <span class='term-row-translation'>
                                                {e.translation
                                                    ? toArabicDigits(
                                                          e.translation
                                                      )
                                                    : '—'}
                                            </span>
                                            <span
                                                class:list={[
                                                    'badge',
                                                    statusBadgeClass[e.status],
                                                ]}
                                            >
                                                {TermStatus[e.status]}
                                            </span>
                                        </button>
                                    </li>
                                ))}
                            </ul>
                        ) : (
                            <p class='letter-empty'>لا مصطلحات بعد</p>
                        )}
                    </section>
                )
            })
        }
    </div>

    <p class='no-results' hidden>لا نتائج تطابق بحثك.</p>

    <div class='term-dialogs'>
        {
            entries.map((e) => (
                <dialog class='term-dialog-shell' data-term={e.term} aria-label={e.term}>
                    <button class='dialog-close' type='button'>إغلاق</button>
                    <TermDialog {...dialogProps(e)} />
                </dialog>
            ))
        }
    </div>

    <script
        is:inline
        type='application/json'
        id='term-data'
        set:html={JSON.stringify(searchEntries).replace(/</g, '\\u003c')}
    />
    <script
        is:inline
        type='application/json'
        id='relation-data'
        set:html={JSON.stringify(relations).replace(/</g, '\\u003c')}
    />

    <script>
        const search = document.getElementById(
            'term-search'
        ) as HTMLInputElement
        const noResults = document.querySelector('.no-results') as HTMLElement
        const boxes = [...document.querySelectorAll('.letter-box')]
        const entries = JSON.parse(
            document.getElementById('term-data')?.textContent ?? '[]'
        ) as {
            term: string
            translation: string
            explanation: string
            status?: string
            source?: { name: string }[]
        }[]
        const relations = JSON.parse(
            document.getElementById('relation-data')?.textContent ?? '[]'
        ) as { type: string; terms: string[]; note: string }[]

        const relationsFor = (term: string) =>
            relations.filter((r) => r.terms.includes(term))

        const entryOf = (term: string | undefined) =>
            entries.find((e) => e.term === term)
        const matches = (e: (typeof entries)[number], q: string) =>
            [
                e.term,
                e.translation,
                e.explanation,
                ...(Array.isArray(e.source) ? e.source : []).map((s) => s.name),
                ...relationsFor(e.term).flatMap((r) => [r.note, ...r.terms]),
            ]
                .join(' ')
                .toUpperCase()
                .includes(q)

        const currentFilter = () =>
            document.querySelector<HTMLInputElement>(
                'input[name="term-filter"]:checked'
            )?.value ?? 'all'

        const passesFilter = (e: (typeof entries)[number], f: string) => {
            if (f === 'all') return true
            if (f === 'translated') return Boolean(e.translation?.trim())
            return e.status === f
        }

        const applyFilters = () => {
            const q = search.value.trim().toUpperCase()
            const f = currentFilter()
            const filtering = q !== '' || f !== 'all'
            let any = false

            for (const box of boxes) {
                const rows = [...box.querySelectorAll('.term-row')]
                if (rows.length === 0) {
                    // empty-letter boxes only show when nothing is being filtered
                    box.toggleAttribute('hidden', filtering)
                    continue
                }
                let visible = 0
                for (const row of rows) {
                    const e = entryOf((row as HTMLElement).dataset.term)
                    const show =
                        e != null &&
                        passesFilter(e, f) &&
                        (q === '' || matches(e, q))
                    // hide the <li> wrapper so no empty bullets/gaps remain
                    ;(row.closest('li') ?? row).toggleAttribute('hidden', !show)
                    if (show) visible++
                }
                box.toggleAttribute('hidden', visible === 0)
                if (visible > 0) any = true
            }
            noResults.toggleAttribute('hidden', !filtering || any)
        }

        search.addEventListener('input', applyFilters)
        document
            .querySelectorAll('input[name="term-filter"]')
            .forEach((r) => r.addEventListener('change', applyFilters))

        const dialogs = new Map(
            [...document.querySelectorAll('dialog[data-term]')].map((d) => [
                (d as HTMLElement).dataset.term,
                d as HTMLDialogElement,
            ])
        )

        const openTerm = (term: string | undefined) => {
            const target = term ? dialogs.get(term) : undefined
            if (!target) return
            document.querySelector('dialog[open]')?.close()
            target.showModal()
        }

        document.addEventListener('click', (ev) => {
            if (!(ev.target instanceof Element)) return
            const row = ev.target.closest('.term-row')
            if (row) {
                openTerm((row as HTMLElement).dataset.term)
                return
            }
            const chip = ev.target.closest('button.relation-chip')
            if (chip) {
                openTerm((chip as HTMLElement).dataset.term)
                return
            }
            const closer = ev.target.closest('.dialog-close')
            if (closer) {
                closer.closest('dialog')?.close()
                return
            }
            if (
                ev.target instanceof HTMLDialogElement &&
                ev.target.open
            ) {
                ev.target.close()
            }
        })
    </script>
</BaseLayout>
