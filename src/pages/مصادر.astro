---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourcePlaceholder from '../components/SourcePlaceholder.astro';
import raw from '../data/sources.json';
import { toArabicDigits } from '../utils/arabicDigits';

interface Source {
  name: string;
  description: string;
  url: string;
  image?: string;
}
type SourceGroup = Record<string, Source[]>;

const sources = raw as SourceGroup[];

const categories = sources.flatMap((group) =>
  Object.entries(group).map(([name, items]) => ({ name, items }))
);

const hostOf = (url: string) => new URL(url).hostname;
---

<BaseLayout title="مصادر">
  <header>
    <h1>مصادر</h1>
    <p>جهات ومنشورات ألهمت بعض هذا العمل — مع الشكر لمن صكّ المصطلح قبلنا.</p>
  </header>

  {categories.map((category) => (
    <section class="source-category">
      <h2>{category.name}</h2>
      <hr>
      <br>
      <div class="source-grid">
        {category.items.map((item) => (
          <article class="source-card">
            <div class="source-pic">
              {item.image ? (
                <img src={item.image} alt={item.name} loading="lazy" />
              ) : (
                <SourcePlaceholder />
              )}
            </div>
            <div class="source-text">
              <h3 class="source-name">{toArabicDigits(item.name)}</h3>
              {item.description && (
                <p class="source-desc">{toArabicDigits(item.description)}</p>
              )}
              <p class="source-link">
                الرابط: <a href={item.url} target="_blank" rel="noopener">{hostOf(item.url)}</a>
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>