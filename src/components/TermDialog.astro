---
import './term-dialog.css'

// TermDialog.astro
const { e, status, termFormation, termSource, termMotivation,
        alts, derivs, rels, sources,
        classes, labels, formationClasses, formationLabels,
        sourceClasses, sourceLabels, motivationClasses, motivationLabels } = Astro.props;

const meta = [
  ['الحالة',  classes[status],                  labels[status]],
  ['الصياغة', formationClasses[termFormation],  formationLabels[termFormation]],
  ['المصدر',  sourceClasses[termSource],        sourceLabels[termSource]],
  ['الدافع',  motivationClasses[termMotivation], motivationLabels[termMotivation]],
].filter(([, , text]) => text);
---

<article class="term-dialog-content">
  <header class="term-head">
    <h2 class="term-translation">{e.translation || '—'}</h2>
    <h2 class="term-original" dir="ltr">{e.term}</h2>
  </header>

  <table class="term-meta">
    <tbody>
      <tr>
        {meta.map(([label, cls, text]) => (
          <Fragment>
            <th scope="row">{label}</th>
            <td><span class={`badge ${cls}`}>{text}</span></td>
          </Fragment>
        ))}
      </tr>
    </tbody>
  </table>

  <div class="term-body">
    {e.explanation && (
      <section class="term-section is-wide">
        <h2>الشرح</h2>
        <p>{e.explanation}</p>
      </section>
    )}

    {alts && (
      <section class="term-section is-wide">
        <h2>بدائل مطروحة</h2>
        <ul set:html={alts} />
      </section>
    )}

     {derivs && (
      <section class="term-section">
        <h2>الاشتقاق</h2>
        <table>
          <thead><tr><th>الصيغة</th><th>المعنى</th></tr></thead>
          <tbody set:html={derivs} />
        </table>
      </section>
    )}

    {rels && (
      <section class="term-section">
        <h2>علاقات</h2>
        <div class="relation-list" set:html={rels} />
      </section>
    )}
  </div>

  {sources && <footer class="dialog-source">المصدر: <Fragment set:html={sources} /></footer>}
</article>