---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: '/', label: 'الرئيسية' },
  { href: '/مدونة', label: 'المدونة' },
  { href: '/مصطلحات', label: 'مصطلحات' },
  { href: '/معاجم', label: 'معاجم' },
  { href: '/المنهجية', label: 'المنهجية' },
  // { href: '/الخط', label: 'الخط' },
  // { href: '/شبكة', label: 'شبكة' },
  { href: '/مصادر', label: 'مصادر' },
];

const normalize = (p: string) =>
  p === '/' ? '/' : decodeURIComponent(p).replace(/\/+$/, '');
const current = normalize(currentPath);
---

<nav class="site-nav">
  <a class="brand" href="/">معراب</a>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} aria-current={normalize(l.href) === current ? 'page' : undefined}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
