---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '') + '/';
const basePath = base.replace(/\/+$/, '');

const links = [
  { href: `${base}`, label: 'الرئيسية' },
  { href: `${base}مدونة`, label: 'المدونة' },
  { href: `${base}مصطلحات`, label: 'مصطلحات' },
  { href: `${base}معاجم`, label: 'معاجم' },
  { href: `${base}المنهجية`, label: 'المنهجية' },
  // { href: `${base}الخط`, label: 'الخط' },
  // { href: `${base}شبكة`, label: 'شبكة' },
  { href: `${base}مصادر`, label: 'مصادر' },
];

const normalize = (p: string) => {
  const decoded = decodeURIComponent(p);
  let rel = decoded;
  if (
    basePath !== '' &&
    (decoded === basePath || decoded.startsWith(basePath + '/'))
  ) {
    rel = decoded.slice(basePath.length);
  }
  return rel.replace(/^\/+|\/+$/g, '') || '/';
};

const current = normalize(currentPath);
---

<nav class="site-nav">
  <a class="brand" href={base}>معراب</a>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} aria-current={normalize(l.href) === current ? 'page' : undefined}>
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
