---
import './periodic-table.css'
import elements from '../data/periodic-table.json'
---

<div class='periodic-table' dir='ltr' lang='en'>
    <ol>
        {
            elements.map((el) => (
                <li data-mass={el.mass} class={el.category}>
                    <abbr title={el.name}>{el.symbol}</abbr>
                    <button
                        class='pt-open'
                        data-element={el.number}
                        aria-haspopup='dialog'
                        aria-label={`${el.name} — عرض التفاصيل والترجمات`}
                    />
                </li>
            ))
        }
    </ol>

    <fieldset dir='rtl'>
        <legend>المرشح</legend>
        <label>
            <input type='radio' name='filter' checked />
            الكل
        </label>
        <label>
            <input type='radio' id='alk' name='filter' />
            فلزات قلوية
        </label>
        <label>
            <input type='radio' id='aec' name='filter' />
            فلزات قلوية ترابية
        </label>
        <label>
            <input type='radio' id='trn' name='filter' />
            فلزات انتقالية
        </label>
        <label>
            <input type='radio' id='trm' name='filter' />
            فلزات بعد انتقالية
        </label>
        <label>
            <input type='radio' id='met' name='filter' />
            أشباه الفلزات
        </label>
        <label>
            <input type='radio' id='rnm' name='filter' />
            اللا فلزات (غير الفلزات)
        </label>
        <label>
            <input type='radio' id='hln' name='filter' />
            هالوجينات
        </label>
        <label>
            <input type='radio' id='nbl' name='filter' />
            الغازات النبيلة
        </label>
        <label>
            <input type='radio' id='lan' name='filter' />
            لانثينيدات
        </label>
        <label>
            <input type='radio' id='act' name='filter' />
            أكتينيدات
        </label>
        <!-- <label>
    <input type="radio" id="brb" name="filter">
    Heisenberg
  </label> -->
    </fieldset>
</div>
{
    elements.map((el) => (
        <div class='stamp'>
            <dialog
                id={`pt-el-${el.number}`}
                class='pt-dialog'
                dir='rtl'
                lang='ar'
                aria-labelledby={`pt-name-${el.number}`}
            >
                <button class='pt-close' data-pt-close>
                    إغلاق
                </button>
                <header class='pt-head'>
                    <div class='pt-translations'>
                        <h3>الترجمات</h3>
                        {el.translations.length === 0 ? (
                            <p class='pt-empty'>
                                لا ترجمات مسجّلة بعد — أضفها في{' '}
                                <code>src/data/periodic-table.json</code>.
                            </p>
                        ) : (
                            <ul class='pt-list'>
                                {el.translations.map((t) => (
                                    <li>
                                        <span class='pt-term'>{t.term}</span>
                                        {t.source && (
                                            <span class='pt-src'>
                                                {' — '}
                                                {t.href ? (
                                                    <a href={t.href}>
                                                        {t.source}
                                                    </a>
                                                ) : (
                                                    t.source
                                                )}
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                    <div class={`pt-figure ${el.category}`} dir='ltr' lang='en'>
                        <span class='pt-number'>{el.number}</span>
                        <span class='pt-mass'>{el.mass}</span>
                        <span class='pt-symbol' id={`pt-name-${el.number}`}>
                            {el.symbol}
                        </span>
                        <span class='pt-elname'>{el.name}</span>
                    </div>
                    <div class='pt-langs'>
                        <h3>لغات أخرى</h3>
                        {(el.languages ?? []).length === 0 ? (
                            <p class='pt-empty'>
                                لا لغات بعد — أضفها في{' '}
                                <code>src/data/periodic-table.json</code>.
                            </p>
                        ) : (
                            <ul class='pt-list'>
                                {el.languages.map((l) => (
                                    <li>
                                        <span class='pt-term'>{l.term}</span>
                                        {l.language && (
                                            <span class='pt-note'>
                                                {'-'}
                                                {l.language}
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        )}
                    </div>
                </header>
                <section class='pt-desc'>
                    <h3>الوصف</h3>
                    {el.description ? (
                        <p>{el.description}</p>
                    ) : (
                        <p class='pt-empty'>
                            لا وصف بعد — أضفه في{' '}
                            <code>src/data/periodic-table.json</code>.
                        </p>
                    )}
                </section>
                <hr />
                <section class='pt-sugg'>
                    <h3>المصطلحات المقترحة</h3>
                    {el.suggestions.length === 0 ? (
                        <p class='pt-empty'>
                            لا اقتراحات بعد — أضفها في{' '}
                            <code>src/data/periodic-table.json</code>.
                        </p>
                    ) : (
                        <ul class='pt-list'>
                            {el.suggestions.map((s) => (
                                <li>
                                    -
                                    <span class='pt-line'>
                                        <span class='pt-term'>{s.term}</span>
                                        {s.symbol && (
                                            <span
                                                class={`pt-mini ${el.category}`}
                                                dir='ltr'
                                                lang='ar'
                                                aria-label={`رمز مقترح: ${s.symbol}`}
                                            >
                                                {s.symbol}
                                            </span>
                                        )}
                                        {s.note && (
                                            <span class='pt-note'>
                                                {' — '}
                                                {s.note}
                                            </span>
                                        )}
                                        {s.source && (
                                            <span class='pt-src'>
                                                {' — '}
                                                {s.href ? (
                                                    <a href={s.href}>
                                                        {s.source}
                                                    </a>
                                                ) : (
                                                    s.source
                                                )}
                                            </span>
                                        )}
                                    </span>
                                </li>
                            ))}
                        </ul>
                    )}
                </section>
            </dialog>
        </div>
    ))
}
<script>
    document.addEventListener('click', (e) => {
        const opener = e.target.closest('.pt-open')
        if (opener) {
            const dlg = document.getElementById(
                `pt-el-${opener.dataset.element}`
            )
            if (dlg instanceof HTMLDialogElement) dlg.showModal()
            return
        }
        const closer = e.target.closest('[data-pt-close]')
        if (closer) closer.closest('dialog')?.close()
    })
</script>
